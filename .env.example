# CLI reads environment variables. This file is a template, not loaded automatically.
KPI_DB_PATH=var/monitor.db
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_PREFIX=kpi/v1
# Stable identity; use a different ID for each independent consumer.
MQTT_CLIENT_ID=kpi-monitor-local
MQTT_TLS=false
# MQTT_USERNAME=
# MQTT_PASSWORD=
# MQTT_CA_FILE=/path/to/ca.pem
